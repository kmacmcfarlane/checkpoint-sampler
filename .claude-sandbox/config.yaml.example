# .claude-sandbox/config.yaml — sandbox config for the optional agent workflow
#
# Copy this file to .claude-sandbox/config.yaml and edit the paths/flags for your
# machine. The real config.yaml is gitignored (it holds host-specific mount paths).
# Requires 'yq' to be installed on the host.
#

# Host access — control which host resources are mounted into the container.
# Each can also be enabled via CLI flags (--ssh, --git, --docker-socket, --aws)
# or environment variables (CLAUDE_SANDBOX_HOST_ACCESS_*_ENABLED=1).
# Precedence: CLI flag > env var > YAML.
hostAccess:
  # Mount ~/.ssh/ read-only (SSH keys for git remotes)
  ssh:
    enabled: true
  # Mount ~/.gitconfig read-only (git identity)
  git:
    enabled: true
  # Mount /var/run/docker.sock (host Docker daemon access).
  # Enable only if the agent needs to drive Docker Compose from inside the sandbox.
  dockerSocket:
    enabled: false
  # Mount ~/.aws/ read-only (AWS CLI/SDK credentials)
  aws:
    enabled: false

# Each mount entry has:
#   host:      absolute path on the host (required)
#   container: absolute path inside the container (required)
#   writable:  boolean, default false (mounts :ro unless true)

mounts:
  - host: /path/to/checkpoints
    container: /data/checkpoints/models-training/checkpoints
  - host: /path/to/models
    container: /data/models
  - host: /path/to/loras
    container: /data/loras
  - host: /path/to/samples
    container: /data/samples
    writable: true
  # Mount your workspace so the agent can edit this repo. Point at the directory
  # that contains the checkout (the same path on host and container keeps
  # docker-compose volume resolution working against the host daemon).
  - host: /path/to/workspace
    container: /path/to/workspace
    writable: true
  #
  # - host: /path/to/datasets
  #   container: /mnt/data
  #   writable: true

# Own project: track the .claude-sandbox/ dir in this repo (no sidecar).
trackInHost: true
