# Host path to the checkpoint directory (mounted read-only into the backend container).
# Contains .safetensors checkpoint files organized in subdirectories.
CHECKPOINT_DIR=/path/to/your/checkpoints

# Host path to the sample image directory (mounted read-write into the backend container).
# Contains ComfyUI output directories named after checkpoint filenames. The app writes
# generated samples, thumbnails, and demo data here.
SAMPLE_DIR=/path/to/your/samples

# Host path to the base model directory (mounted read-only into the backend container).
# Contains base model .safetensors files used for LoRA job inference.
MODEL_DIR=/path/to/your/models

# Host path to the LoRA directory (mounted read-only into the backend container).
# Contains LoRA .safetensors files organized in subdirectories.
LORA_DIR=/path/to/your/loras

# Host interface Docker Compose binds the published ports to (default: 127.0.0.1,
# i.e. localhost-only — the app has no authentication, so anyone who can reach
# the port has full access). Uncomment and set to 0.0.0.0 to deliberately expose
# the app on your LAN; put a firewall or authenticating reverse proxy in front of
# it first. See README "Security model".
# HOST_BIND=0.0.0.0
