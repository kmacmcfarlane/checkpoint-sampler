#!/usr/bin/env bash
#
# pre-commit hook: run the dependency vulnerability audit before allowing a commit.
#
# Installed via `make install-hooks` (sets core.hooksPath=scripts/git-hooks).
# Fails the commit on high-severity findings; degrades to a visible warning when
# offline (see scripts/audit.sh).
#
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
echo "[pre-commit] running 'make audit'..."
make -C "$REPO_ROOT" audit
