# Checkpoint Sampler configuration
# Override path with CONFIG_PATH environment variable.

# Directories to recursively scan for .safetensors checkpoint files.
# Multiple directories can be specified.
checkpoint_dirs:
  - /data/checkpoints

# Directories to recursively scan for LoRA .safetensors files (optional).
# LoRA training runs are discovered separately from checkpoint training runs.
# lora_dirs:
#   - /data/loras

# Directory for base model browsing (optional).
# Used to populate the base model dropdown when launching LoRA sample jobs.
# base_model_dir: /data/models

# Directory where sample image output directories live.
# Each subdirectory is named after the checkpoint filename (exact match).
# Generated images from sample jobs are also saved here.
sample_dir: /data/samples

# Backend server port
port: 8080

# Bind address for the backend's own network listener (inside the container,
# not the same thing as host/LAN exposure).
#
# Running under Docker Compose (the default): leave this as 0.0.0.0. The
# backend must bind all interfaces inside its container so Docker's port
# mapping (docker-compose.yml `ports:`) can reach it at all. Whether the app
# is actually reachable from your LAN is controlled entirely at the compose
# layer via the HOST_BIND env var (default 127.0.0.1, i.e. host-only) — see
# the README "Security model" section. Changing this value does NOT expose
# or restrict LAN access; it only affects what the backend binds to inside
# its own container network namespace.
#
# Running the backend directly on the host (no Docker): 0.0.0.0 binds all
# host interfaces (LAN-reachable); 127.0.0.1 restricts it to localhost only.
# There is no authentication, so anyone who can reach this address and port
# has full access — do not bind 0.0.0.0 outside Docker unless you have your
# own firewall or reverse-proxy authentication in front of it.
ip_address: "0.0.0.0"

# SQLite database path (relative to working directory)
db_path: ./data/checkpoint-sampler.db

# Thumbnail generation settings (optional).
# When enabled, JPEG thumbnails are generated when sample images are created.
# Thumbnails are stored in a "thumbnails/" subdirectory within each checkpoint's
# sample directory. The grid view uses thumbnails for faster loading while the
# lightbox continues to serve full-resolution images.
# If omitted (or enabled: false), thumbnail generation is disabled.
# thumbnails:
#   enabled: true
#   max_resolution_x: 512
#   max_resolution_y: 512
#   jpeg_quality: 85

# WebSocket heartbeat ping interval in seconds (optional, default: 30).
# Periodic ping frames keep idle WebSocket connections alive through proxies
# that enforce short read timeouts (e.g. nginx proxy_read_timeout).
# Set to 0 to disable pings entirely.
# ws_ping_interval: 30

# Maximum HTTP request body size in megabytes (optional, default: 200).
# Requests exceeding this limit are rejected with 413 before the body is
# buffered into memory, protecting against memory-exhaustion DoS attacks.
# Must be a positive integer; 0 or negative values are rejected at startup.
# max_request_size_mb: 200

# Maximum total work items allowed per study/job (optional, default: 50000).
# A study expands into a Cartesian product (prompts x steps x cfgs x
# sampler/scheduler pairs x seeds x lora-strength pairs x checkpoints). This cap
# bounds that product so a single study/job cannot create millions of rows.
# Studies are rejected at save time if their per-checkpoint product exceeds the
# limit, and job creation is rejected if checkpoints x images-per-checkpoint
# exceeds it. Must be a positive integer; 0 or negative values are rejected at
# startup.
# max_study_items: 50000

# Additional allowed browser origins for WebSocket and CORS (optional, default: empty).
# By default the server only accepts cross-origin browser requests whose Origin
# hostname matches the request Host hostname (scheme and port are ignored). This
# covers IP access, dev mode (Vite on a different port), and Host-preserving
# reverse proxies such as Caddy. Requests with no Origin header (curl, non-browser
# clients) are always allowed. Set allowed_origins only if your proxy rewrites the
# Host header so the same-host default no longer matches. Entries may be full
# origins (https://host[:port]) or bare hostnames; matching is hostname-only.
# allowed_origins:
#   - https://checkpoint-sampler.example.com

# ComfyUI connection settings for inference pipeline (optional).
# If omitted, inference pipeline features are disabled in the UI.
# The URL must include the scheme (http:// or https://).
#
# IMPORTANT: the backend runs inside a Docker container, so "url" is resolved
# from the container's network namespace, not your host machine. localhost
# (or 127.0.0.1) here resolves to the backend container itself, NOT to a
# ComfyUI instance running on your host machine — you will get a permanent
# "ComfyUI (offline)" status pill. If ComfyUI runs on the same machine as
# Docker, use host.docker.internal (docker-compose.yml already adds the
# extra_hosts entry needed for this to resolve on Linux Docker Engine
# 20.10+ and Docker Desktop). If ComfyUI runs on another machine, use its
# LAN IP address instead. localhost:8188 only works if you run the backend
# directly on the host (outside Docker).
# comfyui:
#   url: http://host.docker.internal:8188
#   workflow_dir: ./workflows
#   reconnect_interval: 10  # Seconds between WebSocket reconnect attempts (default: 10)
